# =============================================================================
# 环境变量样例文件 —— .env.example
# 用法：
#   1) 复制为 .env：cp .env.example .env
#   2) 填入你自己的真实配置
#   3) .env 已被 .gitignore 忽略，绝不会提交到 Git
#   4) 本地 IDE 运行：在 IDEA 的 Run Configuration → Environment variables 里粘贴
#      （或安装 EnvFile 插件直接加载 .env）
#   5) Docker 部署：docker compose --env-file .env up -d
#   6) Linux 服务器：source .env && java -jar school-points.jar --spring.profiles.active=prod
# =============================================================================

# ----------------------------- 运行环境 -----------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ----------------------------- 数据库 MySQL 8 -----------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_points
DB_USERNAME=root
DB_PASSWORD=root

# ----------------------------- 自建 SMTP 邮件服务器（必填） -----------------------------
# 说明：注册验证码、找回密码、绑定邮箱、改密通知全部通过你自己的 SMTP 发送，
#       系统不使用任何第三方邮件 API。
# 465 端口（SSL）：MAIL_SSL_ENABLE=true  MAIL_STARTTLS_ENABLE=false
# 587 端口（STARTTLS）：MAIL_SSL_ENABLE=false MAIL_STARTTLS_ENABLE=true
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=your@example.com
MAIL_FROM_NAME=校园班级量化积分管理系统
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
MAIL_ENABLED=true

# ----------------------------- hCaptcha 人机校验（必填） -----------------------------
# site-key 会通过 /api/auth/captcha/config 下发给前端（前端只允许出现 site-key）
# secret-key 只允许存在于后端环境变量，严禁写入前端或提交到 Git
HCAPTCHA_ENABLED=true
HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
HCAPTCHA_VERIFY_URL=https://api.hcaptcha.com/siteverify

# ----------------------------- JWT -----------------------------
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-me-please-use-a-random-secret-at-least-32-bytes
JWT_EXPIRE=86400
JWT_REMEMBER_EXPIRE=604800
TOKEN_BLACKLIST_ENABLED=true

# ----------------------------- Redis（可选，关闭时自动降级） -----------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ----------------------------- 站点信息 -----------------------------
SITE_NAME=校园班级量化积分管理系统
SCHOOL_NAME=示范中学
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SWAGGER_ENABLED=true
LOG_PATH=./logs
LOG_LEVEL=DEBUG

# ----------------------------- 文件上传 -----------------------------
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=20MB
