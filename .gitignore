# =============================================================================
# Git 忽略规则 —— 核心目的：敏感配置绝不进仓库
# =============================================================================

# ----------------------------- 敏感配置（最重要） -----------------------------
# 环境变量文件：包含数据库密码、SMTP 密码、hCaptcha secret、JWT 密钥
.env
.env.*
!.env.example
*.env
application-local.yml
application-local.yaml
application-local.properties
application-secret.yml

# ----------------------------- 构建产物 -----------------------------
target/
build/
out/
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ----------------------------- 日志 -----------------------------
logs/
*.log
*.log.gz
log/

# ----------------------------- 运行时数据 -----------------------------
data/
upload/
temp/
tmp/
*.tmp

# ----------------------------- IDE -----------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# ----------------------------- 操作系统 -----------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------- 其他 -----------------------------
*.bak
*.swp
*~
node_modules/
dist/
